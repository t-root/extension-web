{
  "manifest_version": 3,
  "name": "Auto Next LMS HUTECH",
  "version": "2.2",
  "description": "Tự động tua video và chuyển bài LMS HUTECH (Có công tắc Bật/Tắt, chỉnh tốc độ video)",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lms.hutech.edu.vn/*",
        "https://*.hutech.edu.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}